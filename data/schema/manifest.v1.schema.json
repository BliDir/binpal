{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BliDir/binpal/main/data/schema/manifest.v1.schema.json",
  "title": "BinPal manifest, schema version 1",
  "description": "Small index served at /manifest.json. The app fetches it to find which areas are covered and whether its cached bundle is out of date.",
  "type": "object",
  "required": ["schema_version", "generated_at", "municipalities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "$ref": "common.v1.schema.json#/$defs/schemaVersion" },
    "generated_at": { "$ref": "common.v1.schema.json#/$defs/dateTime" },
    "municipalities": {
      "type": "array",
      "items": { "$ref": "#/$defs/municipality" }
    },
    "boundaries": {
      "description": "Latest boundary package for each prefecture that has one. May be omitted when none is published.",
      "type": "array",
      "items": { "$ref": "#/$defs/boundaryRef" }
    }
  },
  "$defs": {
    "municipality": {
      "type": "object",
      "required": ["id", "names", "area_ids", "bundles"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/municipalityId" },
        "names": { "$ref": "common.v1.schema.json#/$defs/names" },
        "ward_ids": {
          "description": "Ward codes of a designated city, so the app can map the ward prefix of a detected area ID to this municipality. Omit when the municipality has no wards.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/municipalityId" }
        },
        "area_ids": {
          "description": "Every area in the latest bundle, so the app can tell whether a detected chōme is covered before downloading.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/areaId" }
        },
        "bundles": {
          "description": "Latest bundle for each bundle schema version still published, highest schema_version first. The app picks the first entry it supports.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bundleRef" }
        }
      }
    },
    "bundleRef": {
      "type": "object",
      "required": ["schema_version", "bundle_version", "path", "sha256", "size_bytes", "published_at"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "description": "Bundle schema version. Not limited to this manifest's own version.",
          "type": "integer",
          "minimum": 1
        },
        "bundle_version": { "type": "integer", "minimum": 1 },
        "path": {
          "description": "Path relative to the CDN root.",
          "type": "string",
          "pattern": "^/bundles/[0-9]{5}/(v[0-9]+/)?[0-9]+\\.json$"
        },
        "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "published_at": { "$ref": "common.v1.schema.json#/$defs/dateTime" }
      }
    },
    "boundaryRef": {
      "type": "object",
      "required": ["prefecture_code", "schema_version", "version", "path", "bbox", "sha256", "size_bytes", "published_at"],
      "additionalProperties": false,
      "properties": {
        "prefecture_code": {
          "description": "2-digit prefecture code. Kanagawa is 14.",
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "schema_version": {
          "description": "Boundary package schema version.",
          "type": "integer",
          "minimum": 1
        },
        "version": { "type": "integer", "minimum": 1 },
        "path": {
          "description": "Path relative to the CDN root.",
          "type": "string",
          "pattern": "^/boundaries/[0-9]{2}/[0-9]+\\.json$"
        },
        "bbox": {
          "description": "West, south, east, north in degrees. The app downloads the packages whose box contains the device's position.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "published_at": { "$ref": "common.v1.schema.json#/$defs/dateTime" }
      }
    }
  }
}
