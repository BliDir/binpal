{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BliDir/binpal/main/data/schema/manifest.v1.schema.json",
  "title": "BinPal manifest, schema version 1",
  "description": "Small index served at /manifest.json. The app fetches it to find which areas are covered and whether its cached bundle is out of date.",
  "type": "object",
  "required": ["schema_version", "generated_at", "municipalities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "$ref": "common.v1.schema.json#/$defs/schemaVersion" },
    "generated_at": { "$ref": "common.v1.schema.json#/$defs/dateTime" },
    "municipalities": {
      "type": "array",
      "items": { "$ref": "#/$defs/municipality" }
    }
  },
  "$defs": {
    "municipality": {
      "type": "object",
      "required": ["id", "names", "area_ids", "bundles"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/municipalityId" },
        "names": { "$ref": "common.v1.schema.json#/$defs/names" },
        "area_ids": {
          "description": "Every area in the latest bundle, so the app can tell whether a detected chōme is covered before downloading.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.v1.schema.json#/$defs/areaId" }
        },
        "bundles": {
          "description": "Latest bundle for each bundle schema version still published, highest schema_version first. The app picks the first entry it supports.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bundleRef" }
        }
      }
    },
    "bundleRef": {
      "type": "object",
      "required": ["schema_version", "bundle_version", "path", "sha256", "size_bytes", "published_at"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "description": "Bundle schema version. Not limited to this manifest's own version.",
          "type": "integer",
          "minimum": 1
        },
        "bundle_version": { "type": "integer", "minimum": 1 },
        "path": {
          "description": "Path relative to the CDN root.",
          "type": "string",
          "pattern": "^/bundles/[0-9]{5}/(v[0-9]+/)?[0-9]+\\.json$"
        },
        "sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "published_at": { "$ref": "common.v1.schema.json#/$defs/dateTime" }
      }
    }
  }
}
